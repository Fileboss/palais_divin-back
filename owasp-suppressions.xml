<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!--
        Template for false-positive triage. Copy and customise per finding.
        Always include a notes block with the rationale and a review date.

        <suppress>
